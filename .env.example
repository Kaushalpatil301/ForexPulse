# ForexPulse Environment Configuration Template

# Server Port (Render sets this dynamically)
PORT=3001

# Node Environment
NODE_ENV=production

# CORS Allowed Origins (Comma-separated or * for universal)
CORS_ORIGIN=*

# Optional: Open Exchange Rates App ID (Enables hourly public data)
# Sign up for a free key at https://openexchangerates.org
OXR_APP_ID=

# Premium Enterprise Integration (Optional)
# Expected endpoint returning { rates: Record<string, number>, timestamp: number }
PREMIUM_API_URL=
PREMIUM_API_KEY=

# Premium Quota Guardrails (~$5/day at $0.001/call)
PREMIUM_DAILY_CALLS=5000
PREMIUM_PER_USER=10

# Quota Storage Path (Defaults to .data/quota.json)
QUOTA_STORAGE_PATH=.data/quota.json

# Optional: Redis URL for multi-instance distributed caching & quotas
# REDIS_URL=redis://localhost:6379

